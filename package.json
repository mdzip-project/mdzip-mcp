{
  "name": "@mdzip/mcp-server",
  "version": "0.1.0",
  "description": "Standalone MCP server that lets AI tools read, search and edit MDZip (.mdz) documents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdzip-project/mdzip-mcp"
  },
  "bugs": {
    "url": "https://github.com/mdzip-project/mdzip-mcp/issues"
  },
  "homepage": "https://github.com/mdzip-project/mdzip-mcp#readme",
  "keywords": [
    "mdzip",
    "mdz",
    "markdown",
    "mcp",
    "model-context-protocol"
  ],
  "bin": {
    "mdzip-mcp-server": "dist/mdzip-mcp-server.js"
  },
  "files": [
    "dist/mdzip-mcp-server.js",
    "dist/THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/mcp-smoke.cjs && node --test tests/atomic-write.test.cjs tests/discovery.test.cjs tests/limits.test.cjs tests/readonly.test.cjs tests/roots.test.cjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@mdzip/core-js": "^2.2.1",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@types/node": "^20.19.39",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
